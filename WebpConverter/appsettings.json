{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LogOptions": {
    "FolderPath": "Logs",
    "FileName": "log.txt",
    "MinimumLevel": "Information"
  },
  "AppOptions": {
    "StoragePath": "./local-cdn",
    "PublicUrlPath": "/images",
    "ImageCompressionQuality": 80,
    "MaxFileSizeBytes": 5242880
  },
  "AllowedHosts": "*"
}