# WebpConverter Environment Variables Configuration
# Copy this file to '.env' and adjust the values for your production environment

# ------------------------------------------------------------------------------
# Networking & Deployment
# ------------------------------------------------------------------------------

# The external port exposed on your VPS to access the API.
# E.g., if set to 8080, the API will be available at http://your-vps-ip:8080
HOST_PORT=8080

# ------------------------------------------------------------------------------
# Storage & Volumes
# ------------------------------------------------------------------------------

# The absolute path on your VPS (host machine) where the converted WebP images 
# will be physically stored. This is your local CDN directory.
# Ensure the Docker daemon has write permissions to this directory.
HOST_CDN_PATH=/var/www/cdn/images

# ------------------------------------------------------------------------------
# Application Options (WebpConverter constraints)
# ------------------------------------------------------------------------------

# The quality of the WebP compression (0 to 100).
# 80 is a good balance between visual quality and small file size.
COMPRESSION_QUALITY=80

# The maximum allowed size for uploaded images in bytes.
# 5242880 bytes = 5 MB.
MAX_FILE_SIZE=5242880
